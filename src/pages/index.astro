---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Gustavo Ricarate — Portfólio.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Contate-me',
        href: 'mailto:gustavoricarte12271227@gmail.com',
        target: '_blank',
      },
    ]}
    image={{ 
      src: '~/assets/images/hero-image.png', 
      alt: 'Foto de Gustavo Ricarte',
      class: 'rounded-full w-64 h-64 object-cover border-4 border-[#800020]' 
    }}
  >
    <Fragment slot="title">
      <span class="text-base font-serif text-gray-500 block mb-2">Olá, meu nome é:</span>
      <span class="text-[#800020] dark:text-[#A52A2A]">Gustavo Ricarte</span>
    </Fragment>

    <Fragment slot="subtitle">
      Estudante de Análise e Desenvolvimento de Sistemas na <span class="font-semibold text-[#800020]">Universidade São Judas Tadeu</span>. 
      Focado em desenvolvimento Back-end com <span class="italic">Java, MySQL e Swing</span>.
    </Fragment>
  </Hero>

  <Content
    isReversed
    id="sobre"
    tagline="Sobre Mim"
    title="Quem sou eu"
    items={[
      {
        title: 'Formação Acadêmica',
        description: 'Atualmente cursando ADS, buscando criar soluções eficientes e seguras através da programação.',
      },
      {
        title: 'Tecnologias',
        description: 'Especializando-se em ecossistemas Java e bancos de dados relacionais.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&w=2070&q=80',
      alt: 'Imagem representativa',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Desenvolvedor em evolução</h3>
      Apaixonado por tecnologia e resolução de problemas complexos. Tenho facilidade em comunicação e liderança em projetos acadêmicos.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#E2E2D5] dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Features2
    title="Meus Projetos"
    subtitle="Confira alguns dos trabalhos que desenvolvi recentemente."
    tagline="Portfólio"
    items={[
      {
        title: 'Projeto Java Swing',
        description: 'Sistema de desktop completo com integração a banco de dados MySQL.',
        icon: 'tabler:brand-java',
      },
      {
        title: 'Gestão de Dados',
        description: 'Modelagem e otimização de queries para sistemas de alta performance.',
        icon: 'tabler:database',
      },
      {
        title: 'Interface de Usuário',
        description: 'Criação de telas amigáveis e intuitivas utilizando bibliotecas gráficas.',
        icon: 'tabler:layout-board',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white dark:bg-transparent"></div>
    </Fragment>
  </Features2>
</Layout>
