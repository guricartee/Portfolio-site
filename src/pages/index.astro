 ---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Gustavo Ricarte',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Contate-me',
        href: 'mailto:gustavoricarte12271227@gmail.com',
        target: '_blank',
      },
    ]}
    image={{ 
      src: '~/assets/images/hero-image.png', 
      alt: 'Foto de Gustavo Ricarte',
      class: 'rounded-full w-64 h-64 object-cover border-4 border-[#800020]' 
    }}
  >
    <Fragment slot="title">
      <span class="text-base font-serif text-gray-500 block mb-2">Olá, meu nome é:</span>
      <span class="text-[#800020] dark:text-[#A52A2A]">Gustavo Ricarte</span>
    </Fragment>

    <Fragment slot="subtitle">
      Estudante de Análise e Desenvolvimento de Sistemas na <span class="font-semibold text-[#800020]">Universidade São Judas Tadeu</span>. 
      Focado em desenvolvimento Back-end com <span class="italic">Java, MySQL e Swing</span>.
    </Fragment>
  </Hero>

  <Features2
    title="Perfil Acadêmico"
    tagline=""
    columns={1} 
    items={[
      {
        title: 'IFSP',
        subtitle: 'Ensino Médio Técnico em Mecânica Industrial (2021 - 2023)',
        description: 'Em 2021, fui convocada para a matrícula no Instituto Federal de São Paulo onde entrei em 4º lugar. Durante três anos, cursei Técnico em Mecânica, adquirindo habilidades em programação CNC, tratamentos térmicos, resistência dos materiais, física e matemática avançada e processos de fabricação.',
        icon: 'tabler:school',
      },
      {
        title: 'FIAP',
        subtitle: 'Análise e Desenvolvimento de Sistemas (2024 - 2026)',
        description: 'Durante minha experiência na FIAP, participei de projetos inovadores como o ReciclaBalsa e o FixerAI. Em parceria com empresas como AWS e USP, desenvolvi soluções alinhadas à sustentabilidade e tecnologia avançada.',
        icon: 'tabler:certificate',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <Features2
    title="Meus Projetos"
    items={[
      {
        title: 'Projeto Java Swing',
        description: 'Sistema de desktop completo com integração a banco de dados MySQL.',
        icon: 'tabler:coffee', 
      },
      {
        title: 'Gestão de Dados',
        description: 'Modelagem e otimização de queries para sistemas de alta performance.',
        icon: 'tabler:database',
      },
    ]}
  />
</Layout>