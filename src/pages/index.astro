 ---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import { Icon } from 'astro-icon/components'; 

const metadata = {
  title: 'Gustavo Ricarte',
  ignoreTitleTemplate: true,
};

const projects = [
  {
    title: 'Presença por QR-Code',
    description: 'Este é um sistema de controle de presença desenvolvido em Java (Swing) com banco de dados MySQL, voltado para uso em instituições de ensino. Ele permite que a escola cadastre alunos e que os próprios alunos gerem e escaneiem QR Codes para registrar sua entrada e saída nas aulas.',
    image: '/images/image-qrcode.png',
    link: '/qrcode'
  },
  
  
];
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Contate-me',
        href: '#contato',
      },
    ]}
    image={{
      src: '~/assets/images/perfil.png',
      alt: 'Foto de Gustavo Ricarte',
      class: 'mx-auto rounded-lg w-full max-w-md h-auto object-contain border-4 border-[#800020] shadow-2xl bg-white/50'
    }}
  >
    <Fragment slot="title">
      <span class="text-4xl font-light tracking-widest leading-loose text-gray-500 dark:text-slate-400 block mb-4">
        Olá, meu nome é:
      </span>
      <span class="text-[#800020] dark:text-[#A52A2A] font-bold text-6xl tracking-normal">
        Gustavo Ricarte
      </span>
    </Fragment>

    <Fragment slot="subtitle">
      Estudante de Análise e Desenvolvimento de Sistemas na <span class="font-semibold text-[#800020]">Universidade São Judas Tadeu</span>.
      Focado em desenvolvimento Back-end com <span class="italic">Java, Python, MySQL e Swing</span>.
    </Fragment>
  </Hero>

  <Content
    id="sobre"
    isReversed
    tagline="Sobre Mim"
    title="Quem sou eu"
    image={{
      src: '~/assets/images/perfil.png',
      alt: 'Imagem de Perfil',
    }}
  >
    <Fragment slot="content">
      <div class="text-lg text-muted dark:text-slate-400 text-justify mb-8">
        Olá, meu nome é Gustavo Ricarte, nascido no estado de São Paulo. Sou estudante de Análise e Desenvolvimento de Sistemas na 
        Universidade São Judas Tadeu. Atualmente, atuo como desenvolvedor Back-end com foco em Java e estou expandindo minhas 
        habilidades para a área de Infraestrutura e Banco de Dados. Este portfólio é um espaço onde apresento meus principais projetos e talentos.
      </div>

      <div class="flex flex-wrap gap-4 mt-6 justify-center md:justify-start">
        <div class="bg-white p-3 rounded-xl shadow-md border border-gray-100 dark:bg-slate-800">
           <Icon name="tabler:coffee" class="w-10 h-10 text-blue-600" />
        </div>
        <div class="bg-white p-3 rounded-xl shadow-md border border-gray-100 dark:bg-slate-800">
           <Icon name="tabler:brand-python" class="w-10 h-10 text-yellow-500" />
        </div>
        <div class="bg-white p-3 rounded-xl shadow-md border border-gray-100 dark:bg-slate-800">
           <Icon name="tabler:database" class="w-10 h-10 text-blue-800" />
        </div>
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#E5E4D7] dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Features2
    items={[
      {
        title: 'Currículo',
        description: `Meu currículo profissional, no qual apresento meus conhecimentos adquiridos ao longo da minha trajetória, minhas formações acadêmicas e certificações relevantes, além das experiências profissionais que me permitiram desenvolver habilidades práticas.`,
        callToAction: {
          text: 'Baixar CV',
          href: '#',
          variant: 'primary',
        },
      },
      {
        title: 'Certificados',
        description: `Neste quadro, apresento todos os certificados que conquistei ao longo dos meus anos de estudo, adquiridos em plataformas renomadas como Cisco, Fundação Bradesco, Universidade São Judas, entre outras.`,
        callToAction: {
          text: 'Certificados',
          href: '/certificados',
          variant: 'primary',
        },
      },
      {
        title: 'Experiência',
        description: `Minha experiência profissional na área de tecnologia tem sido essencial para agregar valor ao setor de desenvolvimento. Trabalhei com empresas reais, aplicando meus conhecimentos em projetos práticos.`,
        callToAction: {
          text: 'Experiência',
          href: '/experiencia',
          variant: 'primary',
        },
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#E5E4D7] dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <Features2
    title="Perfil Acadêmico"
    columns={1}
    items={[
      {
        title: 'Universidade São Judas Tadeu',
        subtitle: 'Análise e Desenvolvimento de Sistemas (2025 - 2027)',
        description: `Participação em projetos inovadores como o Projeto de Presença por QR-code. Desenvolvi soluções alinhadas ao bem-estar social e tecnologia avançada.`,
        icon: 'tabler:certificate',
      },
    ]}
  />

  <section id="projetos" class="bg-[#1a1a1a] py-20 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-white text-5xl font-bold mb-10">Meus Projetos</h2>
      
      <div class="max-w-2xl mx-auto mb-16 relative">
        <span class="absolute inset-y-0 left-3 flex items-center text-gray-400">
          <Icon name="tabler:search" class="w-6 h-6" />
        </span>
        <input 
          type="text" 
          id="projectSearch"
          placeholder="Pesquisar projetos..." 
          class="w-full bg-white rounded-md py-3 pl-12 pr-4 outline-none text-gray-800 shadow-lg"
        />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-10" id="projectGrid">
        {projects.map((proj) => (
          <div class="project-card group transition-all duration-300 hover:-translate-y-2">
            <a href={proj.link}>
              <div class="bg-[#2a2a2a] rounded-xl overflow-hidden border border-gray-800 transition-all group-hover:border-[#800020] shadow-2xl">
                <img src={proj.image} alt={proj.title} class="w-full aspect-video object-cover" />
                <div class="p-8 text-center">
                  <h3 class="text-white text-2xl font-bold mb-4">{proj.title}</h3>
                  <p class="text-white text-lg text-justify leading-relaxed">{proj.description}</p>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('projectSearch') as HTMLInputElement;
    const projectCards = document.querySelectorAll('.project-card');

    searchInput?.addEventListener('input', () => {
      const searchTerm = searchInput.value.toLowerCase();
      projectCards.forEach(card => {
        const title = card.querySelector('h3')?.textContent?.toLowerCase() || '';
        const desc = card.querySelector('p')?.textContent?.toLowerCase() || '';
        (card as HTMLElement).style.display = (title.includes(searchTerm) || desc.includes(searchTerm)) ? 'block' : 'none';
      });
    });
  </script>
  <Content
    id="contato"
    title="Contato"
    isReversed
  >
    <Fragment slot="image">
      <div class="flex flex-col items-center">
        <img src="/src/assets/images/perfil.png" alt="Gustavo Ricarte" class="mx-auto rounded-lg w-full max-w-sm h-auto object-contain border-4 border-[#800020] shadow-2xl bg-white/50 mb-6" />
        <div class="flex gap-6 justify-center">
          <a href="https://github.com/guricartee" target="_blank">
            <Icon name="tabler:brand-github" class="w-10 h-10 text-gray-800 dark:text-gray-200" />
          </a>
          <a href="https://linkedin.com/in/guricarte" target="_blank">
            <Icon name="tabler:brand-linkedin" class="w-10 h-10 text-blue-700" />
          </a>
        </div>
      </div>
    </Fragment>

    <Fragment slot="content">
      <h3 class="text-2xl font-bold mb-6 underline decoration-[#800020]">Me mande um email</h3>
      
      <form action="https://formspree.io/f/meeqodrq" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1">Nome</label>
          <input type="text" name="name" required class="w-full p-3 rounded-lg border border-gray-200 dark:bg-slate-800" placeholder="Digite seu nome" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Email</label>
          <input type="email" name="email" required class="w-full p-3 rounded-lg border border-gray-200 dark:bg-slate-800" placeholder="Digite seu email" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Mensagem</label>
          <textarea name="message" rows="4" required class="w-full p-3 rounded-lg border border-gray-200 dark:bg-slate-800 resize-none" placeholder="Digite sua mensagem"></textarea>
        </div>
        <button type="submit" class="w-full sm:w-auto px-6 py-3 rounded-lg bg-[#333333] text-white font-semibold hover:bg-[#800020] transition-colors">
          Enviar
        </button>
      </form>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#E5E4D7] dark:bg-transparent"></div>
    </Fragment>
  </Content>