 ---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro'; // ESTA LINHA RESOLVE O ERRO ATUAL

const metadata = {
  title: 'Gustavo Ricarte',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Contate-me',
        href: 'mailto:gustavoricarte12271227@gmail.com',
        target: '_blank',
      },
    ]}
    image={{
      src: '~/assets/images/perfil.png',
      alt: 'Foto de Gustavo Ricarte',
      // rounded-lg e object-contain para a foto aparecer INTEIRA
      class: 'mx-auto rounded-lg w-full max-w-md h-auto object-contain border-4 border-[#800020] shadow-2xl bg-white/50'
    }}
  >
    <Fragment slot="title">
      <span class="text-4xl font-light tracking-widest leading-loose text-gray-500 dark:text-slate-400 block mb-4">
        Olá, meu nome é:
      </span>
      <span class="text-[#800020] dark:text-[#A52A2A] font-bold text-6xl tracking-normal">
        Gustavo Ricarte
      </span>
    </Fragment>

    <Fragment slot="subtitle">
      Estudante de Análise e Desenvolvimento de Sistemas na <span class="font-semibold text-[#800020]">Universidade São Judas Tadeu</span>.
      Focado em desenvolvimento Back-end com <span class="italic">Java, Python, MySQL e Swing</span>.
    </Fragment>
  </Hero>

  <Content
    id="sobre"
    isReversed
    tagline="Sobre Mim"
    title="Quem sou eu"
    image={{
      src: '~/assets/images/perfil.png',
      alt: 'Imagem de Perfil',
    }}
  >
    <Fragment slot="content">
      <div class="text-lg text-muted dark:text-slate-400 text-justify">
        Olá, meu nome é Gustavo Ricarte, nascido no estado de São Paulo. Sou estudante de Análise e Desenvolvimento de Sistemas na 
        Universidade São Judas Tadeu. Atualmente, atuo como desenvolvedor Back-end com foco em Java e estou expandindo minhas 
        habilidades para a área de Infraestrutura e Banco de Dados.
      </div>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#E5E4D7] dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Features2
    title="Perfil Acadêmico"
    columns={1}
    items={[
      {
        title: 'Universidade São Judas Tadeu',
        subtitle: 'Análise e Desenvolvimento de Sistemas (2025 - 2027)',
        description: `Participação em projetos inovadores como o Projeto de Presença por QR-code. Desenvolvi soluções alinhadas ao bem-estar social e tecnologia avançada.`,
        icon: 'tabler:certificate',
      },
    ]}
  />

  <Features2
    title="Meus Projetos"
    items={[
      {
        title: 'Projeto Presença por QR-Code',
        description: `Sistema de controle de presença utilizando Java e MySQL para automatizar o registro de frequência com QR Codes.`,
        icon: 'tabler:coffee',
      },
      {
        title: 'Tabelas MySQL',
        description: 'Modelagem e otimização de tabelas para sistemas de alta performance.',
        icon: 'tabler:database',
      },
    ]}
  />
</Layout>