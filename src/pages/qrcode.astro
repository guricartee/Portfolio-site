 ---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';
---

<Layout>
  <section class="bg-[#E5E4D7] min-h-screen py-12 px-6">
    <div class="max-w-6xl mx-auto">
      <a href="/projetos" class="inline-block mb-8">
        <Icon name="tabler:arrow-left" class="w-8 h-8 text-black" />
      </a>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div>
          <h1 class="text-4xl font-bold mb-6">FixerAI</h1>
          <p class="text-gray-800 text-justify leading-relaxed mb-8">
            Este é um sistema de controle de presença desenvolvido em Java (Swing) com banco de dados MySQL, voltado para uso em instituições de ensino. Ele permite que a escola cadastre alunos e que os próprios alunos gerem e escaneiem QR Codes para registrar sua entrada e saída nas aulas.
          </p>

          <div class="flex gap-6 mb-10">
            <Icon name="tabler:coffee" class="w-10 h-10" title="Java" />
            <Icon name="tabler:database" class="w-10 h-10" title="SQL" />
          </div>

          <div class="mb-10">
            <h2 class="text-2xl font-bold mb-4">Integrantes</h2>
            <ul class="space-y-4 text-gray-800">
             
            </ul>
          </div>

          <a href="https://github.com/guricartee/sistema-presenca-qrcode-java" target="_blank" class="inline-block">
            <Icon name="tabler:brand-github" class="w-12 h-12 text-black hover:scale-110 transition-transform" />
          </a>
        </div>

        <div class="space-y-6">
          <img src="/images/projetos/fixerai-1.png" class="rounded-xl shadow-lg border border-gray-300 w-full" alt="Screenshot 1" />
          <img src="/images/projetos/fixerai-2.png" class="rounded-xl shadow-lg border border-gray-300 w-full" alt="Screenshot 2" />
        </div>
      </div>
    </div>
  </section>
</Layout>