 ---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Certificados | Gustavo Ricarte',
};

// Lista de certificados baseada na sua imagem
const certificados = [
  { title: 'Ambientes computacionais e conectividade', platform: 'São Judas Tadeu', image: '/images/cert-ambientes.png' },
  { title: 'Modelagem de software', platform: 'São Judas Tadeu', image: '/images/cert-modelagem.png' },
  { title: 'Sistemas computacionais e segurança', platform: 'São Judas Tadeu', image: '/images/cert-sistemas.png' },
  { title: 'Programação de soluções computacionais', platform: 'São Judas Tadeu', image: '/images/cert-java.png' },
  { title: 'Fundamentos da análise de dados', platform: 'Cisco', image: '/images/cert-dados.png' },
  { title: 'Começando com o Cisco Packet Tracer', platform: 'Cisco', image: '/images/cert-packet.png' },
  { title: 'Introdução á IoT e Transformação Digital', platform: 'Cisco', image: '/images/cert-iot.png' },
  { title: 'Segurança em Tecnologia da Informação', platform: 'Fundação Bradesco', image: '/images/cert-segurança.png' },
  { title: 'Criando um projeto com interface gráfica utilizando Python', platform: 'Fundação Bradesco', image: '/images/cert-projetopython.png' },
  { title: 'Desenvolvimento orientado a objetos utilizando Python', platform: 'Fundação Bradesco', image: '/images/cert-objetopython.png' },
  { title: 'Excel 2016 - Intermediário', platform: 'Fundação Bradesco', image: '/images/cert-Excel.png' },
  { title: 'Análise de Dados no Power BI', platform: 'Fundação Bradesco', image: '/images/cert-dadosPowerBI.png' },
  { title: 'Modelando Dados no Power BI', platform: 'Fundação Bradesco', image: '/images/cert-modelandodadospowerbi.png' },
];
---

<Layout metadata={metadata}>
  <section class="bg-[#E5E4D7] dark:bg-[#E5E4D7] min-h-screen py-12 px-4 sm:px-6 lg:px-8 transition-colors">
    <div class="max-w-6xl mx-auto">
      
      <div class="mb-8">
        <a href="/" class="flex items-center !text-gray-700 hover:!text-black transition-colors mb-4">
          <Icon name="tabler:arrow-left" class="w-6 h-6 mr-2" />
          <span>Voltar</span>
        </a>
        <h1 class="text-3xl font-bold border-b-2 !border-black inline-block pb-1 !text-gray-900">Certificados</h1>
      </div>

      <div class="flex justify-center mb-12">
        <div class="relative w-full max-w-xl">
          <span class="absolute inset-y-0 left-3 flex items-center">
            <Icon name="tabler:search" class="w-5 h-5 text-gray-400" />
          </span>
          <input 
            type="text" 
            id="searchCert"
            placeholder="Pesquisar certificados..." 
            class="w-full pl-10 pr-4 py-2 border border-gray-300 rounded shadow-sm focus:ring-2 focus:ring-[#800020] focus:border-transparent outline-none bg-white dark:bg-white !text-gray-900 !placeholder-gray-500"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6" id="certGrid">
        {certificados.map((cert) => (
          /* Card: Forçado fundo branco sempre */
          <div class="cert-card bg-white dark:bg-white rounded-lg shadow-md overflow-hidden flex flex-col transition-transform hover:scale-105">
            <div class="aspect-video bg-gray-200">
               <img src={cert.image} alt={cert.title} class="w-full h-full object-cover" />
            </div>
            <div class="p-4 flex-grow flex flex-col justify-center text-center">
              /* Forçando cor do título do certificado */
              <h3 class="text-sm font-semibold !text-gray-800 leading-tight mb-1">
                {cert.title}
              </h3>
              /* Forçando cor da plataforma (itálico) */
              <p class="text-xs !text-gray-600 italic">({cert.platform})</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    const searchInput = document.getElementById('searchCert') as HTMLInputElement;
    const cards = document.querySelectorAll('.cert-card');

    searchInput?.addEventListener('input', () => {
      const searchTerm = searchInput.value.toLowerCase();

      cards.forEach(card => {
        const title = card.querySelector('h3')?.textContent?.toLowerCase() || '';
        const platform = card.querySelector('p')?.textContent?.toLowerCase() || '';
        
        if (title.includes(searchTerm) || platform.includes(searchTerm)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  </script>
</Layout>